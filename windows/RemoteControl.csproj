<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhoneRemote</AssemblyName>
    <Version>2.7.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>RemoteControl</RootNamespace>
    <Product>PhoneRemote</Product>
    <Description>支持 Windows、Mac 和 Android 的局域网和 Tailscale 遥控</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Web\index.html" LogicalName="Web.index.html" />
    <EmbeddedResource Include="Web\styles.css" LogicalName="Web.styles.css" />
    <EmbeddedResource Include="Web\app.js" LogicalName="Web.app.js" />
    <Content Include="..\modules\ipad-display\**\*.ps1;..\modules\ipad-display\**\*.py;..\modules\ipad-display\**\requirements*.txt;..\modules\ipad-display\**\README.md;..\modules\ipad-display\**\*.html;..\modules\ipad-display\**\*.js;..\modules\ipad-display\**\*.css;..\modules\ipad-display\**\*.png;..\modules\ipad-display\**\*.webmanifest"
             Exclude="..\modules\ipad-display\**\.venv\**">
      <Link>modules\ipad-display\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
